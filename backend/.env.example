# Server
NODE_ENV=development
APP_ENV=staging
PORT=4002
API_PREFIX=/api

# Zona horaria del proceso. Mitigación de defensa en profundidad: toda la lógica
# de negocio Argentina-aware (backend/src/shared/datetime/argentinaTime.ts) ya
# usa una zona horaria explícita y NO depende de esta variable, pero fijarla
# igual evita que cualquier código nuevo que use Date local (setHours/getDate/
# toLocaleDateString sin timeZone explícito) se rompa silenciosamente si el
# proceso corre en un host/contenedor con otro huso horario por defecto (ej.
# UTC, el default típico de la mayoría de las imágenes Docker/cloud).
# Nota: para que Node.js la respete de forma confiable, conviene setearla en el
# entorno del proceso/contenedor (Docker ENV, systemd, panel del hosting), no
# solo depender de que dotenv la cargue en runtime.
TZ=America/Argentina/Cordoba

# Frontend origin allowed by CORS.
# Lista explícita separada por comas (nunca "*": el backend usa credentials).
# Para compartir desarrollo por VS Code Dev Tunnels agregar el origin del
# frontend tunnel, ej.:
# CORS_ORIGIN=http://localhost:5174,https://XXXXXXXX-5174.brs.devtunnels.ms
# Local: frontend admin (5174) y fichador standalone (5175).
CORS_ORIGIN=http://localhost:5174,http://localhost:5175

# Neon/PostgreSQL.
# Use the Neon development branch connection string for local backend work.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Auth
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_EXPIRES_IN=7d

# Required only when running the explicit demo seed. Never commit a real value.
DEMO_SEED_PASSWORD=

# Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
REFRESH_RATE_LIMIT_WINDOW_MS=900000
REFRESH_RATE_LIMIT_MAX=30
# Limites de body JSON: fijos en codigo desde F11 (1 MiB general, 6 MiB la
# foto de fichada, 36 MiB los documentos), ver src/shared/http/bodyLimits.ts.
# JSON_BODY_LIMIT ya no existe.

# Fichador (F6/F7): cada request operativo a /api/clock/* exige un
# ClockDevice ACTIVE propio (Authorization: ClockDevice <id>.<secret>),
# enrolado desde la PWA y aprobado por RRHH. No existe secreto compartido ni
# variable para el. El alias legacy /time-entries/clock/* se retiro en F11.
# Cupo por dispositivo autenticado y, antes de autenticar, cupo por IP (mas
# alto: varios kioscos pueden salir por la misma red).
CLOCK_RATE_LIMIT_WINDOW_MS=300000
CLOCK_RATE_LIMIT_MAX=30
CLOCK_IP_RATE_LIMIT_MAX=300
# F7: segundos minimos entre dos fichadas distintas (otro requestId) del mismo
# empleado, con reloj del servidor y desde cualquier dispositivo. Rango 0-300
# (0 desactiva; fuera de rango el backend no arranca). Default 60.
CLOCK_PUNCH_COOLDOWN_SECONDS=60

# IP real del cliente detras de proxies. Cantidad EXACTA de saltos de proxy
# propios entre el cliente y Express; 0 = no confiar en X-Forwarded-For.
# Desarrollo local (directo o por Dev Tunnels): 0. En un deploy real, 0
# haria que rate limiting y auditoria agrupen a todos los clientes bajo la IP
# del proxy, asi que ahi se MIDE antes del primer deploy (nunca se copia de
# documentacion o ejemplos): uno mayor al real deja que un cliente falsifique
# su IP. Procedimiento: docs/decisions/FICHADOR_STANDALONE_PWA_PLAN.md §18.5.
TRUST_PROXY_HOPS=0
# Habilita GET /api/health/client-ip para medir TRUST_PROXY_HOPS. Dejar en
# false salvo durante la medicion.
CLIENT_IP_DIAGNOSTICS_ENABLED=false

# File storage
# Use local for development. Use google_drive in production after sharing the root
# folder with the service account.
STORAGE_PROVIDER=local
# Etapa 15D.2 (docs/decisions/STORAGE_UPLOAD_POLICY_15D2.md): opcionales, sin
# valor por defecto. Sólo afectan a qué provider va un upload NUEVO, por
# módulo/propósito — nunca a la lectura/eliminación de un archivo ya
# existente (eso resuelve por StorageFile.storageProvider persistido, ver
# docs/decisions/STORAGE_PROVIDER_REGISTRY_15D1.md). Cadena de resolución:
# la variable específica -> DEFAULT_STORAGE_PROVIDER -> STORAGE_PROVIDER
# (arriba). Dejarlas vacías es 100% compatible: el comportamiento queda
# igual que antes de esta etapa.
# Decisión de producto: documentos pueden subir a Cloudinary; fotos/evidencia
# de fichada suben a Google Drive por ahora.
# F12-PERF-3/4 (docs/decisions/F12_PERF_3_4.md): con
# PUNCH_PHOTO_STORAGE_PROVIDER=neon_object_storage la foto va a Neon dentro del
# request y su copia a Google Drive sale asíncrona (StorageArchiveJob), así que
# GOOGLE_DRIVE_* debe seguir configurado para el archivo.
DEFAULT_STORAGE_PROVIDER=
DOCUMENT_STORAGE_PROVIDER=
PUNCH_PHOTO_STORAGE_PROVIDER=
NEON_OBJECT_STORAGE_ENDPOINT=
NEON_OBJECT_STORAGE_REGION=us-east-1
NEON_OBJECT_STORAGE_BUCKET=
NEON_OBJECT_STORAGE_ACCESS_KEY_ID=
NEON_OBJECT_STORAGE_SECRET_ACCESS_KEY=
NEON_OBJECT_STORAGE_TIMEOUT_MS=5000
MAX_UPLOAD_SIZE_MB=10
MAX_PUNCH_PHOTO_SIZE_MB=2
CLOCK_ATTEMPT_PROCESSING_TTL_MS=60000
CLOCK_ATTEMPT_RETENTION_DAYS=30
CLOCK_ATTEMPT_MAINTENANCE_INTERVAL_MS=60000
# Desactivar sólo en copias de QA donde el proceso HTTP no debe ejecutar
# vencimientos, alertas, notificaciones, retención ni catch-ups automáticos.
# El default es true para conservar el comportamiento operativo habitual.
AUTOMATIC_JOBS_ENABLED=true
# A la 01:00 de Argentina revisa el día anterior. Una jornada nocturna abierta
# cuenta como actividad aunque sus horas definitivas todavía no estén cerradas.
ATTENDANCE_INACTIVITY_CHECK_HOUR=1
ATTENDANCE_INACTIVITY_CHECK_MINUTE=0

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=gestion-personal

GOOGLE_DRIVE_ENABLED=false
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_DRIVE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_DRIVE_PRIVATE_KEY=
GOOGLE_DRIVE_PROJECT_ID=
