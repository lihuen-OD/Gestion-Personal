# Server
NODE_ENV=development
APP_ENV=staging
PORT=4002
API_PREFIX=/api

# Zona horaria del proceso. Mitigación de defensa en profundidad: toda la lógica
# de negocio Argentina-aware (backend/src/shared/datetime/argentinaTime.ts) ya
# usa una zona horaria explícita y NO depende de esta variable, pero fijarla
# igual evita que cualquier código nuevo que use Date local (setHours/getDate/
# toLocaleDateString sin timeZone explícito) se rompa silenciosamente si el
# proceso corre en un host/contenedor con otro huso horario por defecto (ej.
# UTC, el default típico de la mayoría de las imágenes Docker/cloud).
# Nota: para que Node.js la respete de forma confiable, conviene setearla en el
# entorno del proceso/contenedor (Docker ENV, systemd, panel del hosting), no
# solo depender de que dotenv la cargue en runtime.
TZ=America/Argentina/Cordoba

# Frontend origin allowed by CORS.
# Local Vite default:
CORS_ORIGIN=http://localhost:5173

# Neon/PostgreSQL.
# Use the Neon development branch connection string for local backend work.
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Auth
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET="change-me-refresh-secret"
JWT_REFRESH_EXPIRES_IN=7d

# Security
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
JSON_BODY_LIMIT=40mb

# Secreto compartido que el fichador (kiosco, sin sesion de usuario) debe
# enviar en el header x-clock-device-token para poder usar /clock/*. Es una
# mitigacion minima viable y TEMPORAL contra abuso anonimo de la API — no
# reemplaza una restriccion de red real (VPN/IP allowlist), no es verificacion
# biometrica, y no es seguridad final de produccion. Ver
# docs/SECURITY_STANDARDS.md -> "Public clock endpoints (fichador)".
# Si se deja vacio:
#  - en NODE_ENV=production: /clock/* queda rechazado (falla cerrado), no
#    publico sin control.
#  - en cualquier otro entorno (development/test/demo): /clock/* sigue
#    funcionando sin este control, mostrando un warning en el log.
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Debe coincidir con VITE_CLOCK_DEVICE_TOKEN en frontend/.env.
CLOCK_DEVICE_TOKEN=

# File storage
# Use local for development. Use google_drive in production after sharing the root
# folder with the service account.
STORAGE_PROVIDER=local
MAX_UPLOAD_SIZE_MB=10
MAX_PUNCH_PHOTO_SIZE_MB=2
CLOCK_ATTEMPT_PROCESSING_TTL_MS=60000
CLOCK_ATTEMPT_RETENTION_DAYS=30
CLOCK_ATTEMPT_MAINTENANCE_INTERVAL_MS=60000
# A la 01:00 de Argentina revisa el día anterior. Una jornada nocturna abierta
# cuenta como actividad aunque sus horas definitivas todavía no estén cerradas.
ATTENDANCE_INACTIVITY_CHECK_HOUR=1
ATTENDANCE_INACTIVITY_CHECK_MINUTE=0

CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=gestion-personal

GOOGLE_DRIVE_ENABLED=false
GOOGLE_DRIVE_ROOT_FOLDER_ID=
GOOGLE_DRIVE_SERVICE_ACCOUNT_EMAIL=
GOOGLE_DRIVE_PRIVATE_KEY=
GOOGLE_DRIVE_PROJECT_ID=
