model DoubleHourRule {
  id                          String                       @id @default(uuid())
  name                        String
  recurrenceType              RecurrenceType
  // SEMANAL/RANGO: define la vigencia junto con weekdays. FECHA: ya no se lee
  // fromDate/toDate para la condición — la o las fechas alcanzadas viven en
  // `dates` (Etapa 8B), porque una regla FECHA puede cubrir muchas fechas
  // (ej. "Feriados 2026") o una sola (ej. "Feriado Navidad").
  fromDate                    DateTime                     @db.Date
  toDate                      DateTime?                    @db.Date
  weekdays                    Int[]                        @default([])
  multiplier                  Decimal                      @default(2) @db.Decimal(4, 2)
  // Etapa 8B: desempata superposición cuando 2+ reglas matchean el mismo
  // tramo — gana la de mayor prioridad. Empate entre las de mayor prioridad
  // se resuelve igual que antes (mayor multiplicador) pero queda marcado
  // como conflicto en SpecialHourRuleApplication.wasConflicting.
  priority                    Int                          @default(0)
  // Etapa 12B: clasificación estructurada, independiente del nombre libre —
  // ver DoubleHourRuleKind. Default OTRO, sin backfill por nombre.
  kind                        DoubleHourRuleKind           @default(OTRO)
  // Etapa 8B: alcance opcional — null = sin restricción en esa dimensión.
  // Todas las dimensiones configuradas (compañía/sector/centro de
  // costo/puesto/empleados específicos) combinan con AND. Sin ninguna
  // configurada + sin empleados, la regla aplica a cualquier empleado que
  // efectivamente trabaje/fiche en la fecha alcanzada.
  companyId                   String?
  sectorId                    String?
  costCenterId                String?
  positionId                  String?
  status                      RecordStatus                 @default(ACTIVO)
  reason                      String
  createdByUserId             String?
  createdAt                   DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt                   DateTime                     @updatedAt @db.Timestamptz(3)
  employees                   DoubleHourRuleEmployee[]
  dates                       SpecialHourRuleDate[]
  company                     Company?                     @relation(fields: [companyId], references: [id])
  sector                      Sector?                      @relation(fields: [sectorId], references: [id])
  costCenter                  CostCenter?                  @relation(fields: [costCenterId], references: [id])
  position                    Position?                    @relation(fields: [positionId], references: [id])
  createdBy                   User?                        @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  specialHourRuleApplications SpecialHourRuleApplication[]

  @@index([status, fromDate, toDate])
}

model DoubleHourRuleEmployee {
  ruleId     String
  employeeId String
  rule       DoubleHourRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  employee   Employee       @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@id([ruleId, employeeId])
  @@index([employeeId])
}

// Etapa 8B: fechas explícitas de una DoubleHourRule con recurrenceType =
// FECHA (feriados, fechas manuales) — reemplaza el uso de fromDate como "la
// única fecha" para ese tipo. Togglable (isActive) sin perder historial.
model SpecialHourRuleDate {
  id        String   @id @default(uuid())
  ruleId    String
  date      DateTime @db.Date
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now()) @db.Timestamptz(3)

  rule DoubleHourRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)

  @@unique([ruleId, date])
  @@index([date])
}

// Trazabilidad de qué DoubleHourRule aplicó a qué TimeSegment. No reemplaza
// a DoubleHourRule (que sigue siendo el motor de reglas especiales) — registra
// TODAS las reglas que matchearon un segmento, aunque el multiplicador
// efectivo que se lleva a TimeEntry.appliedMultiplier sea sólo el de la(s)
// regla(s) ganadora(s) por prioridad (Etapa 8B) — nunca se acumulan ni
// multiplican entre sí.
model SpecialHourRuleApplication {
  id                String   @id @default(uuid())
  timeSegmentId     String
  doubleHourRuleId  String
  multiplierApplied Decimal  @db.Decimal(4, 2)
  // Etapa 8B: congelados al momento de aplicar — no se recalculan si la
  // prioridad de la regla cambia después (trazabilidad histórica real).
  isWinner          Boolean  @default(false)
  wasConflicting    Boolean  @default(false)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)

  timeSegment    TimeSegment    @relation(fields: [timeSegmentId], references: [id], onDelete: Cascade)
  doubleHourRule DoubleHourRule @relation(fields: [doubleHourRuleId], references: [id], onDelete: Restrict)

  @@index([timeSegmentId])
}

model AttendancePunch {
  id                   String                 @id @default(uuid())
  employeeId           String
  type                 AttendancePunchType
  timestamp            DateTime               @db.Timestamptz(3)
  source               WorkShiftSource        @default(PORTAL_DNI)
  deviceId             String?
  kioskId              String?
  ipAddress            String?
  userAgent            String?
  status               AttendancePunchStatus  @default(VALIDA)
  observation          String?
  reviewStatus         AttendanceReviewStatus @default(PENDIENTE)
  reviewedAt           DateTime?              @db.Timestamptz(3)
  reviewedByUserId     String?
  reviewNote           String?
  photoUrl             String?
  photoStoragePath     String?
  photoFileId          String?
  thumbnailFileId      String?
  faceDetected         Boolean                @default(false)
  faceValidationStatus FaceValidationStatus?
  faceDetectionScore   Float?
  externalPunchId      String?
  rawPayload           Json?
  biometricProvider    String?
  importedAt           DateTime?              @db.Timestamptz(3)
  createdAt            DateTime               @default(now()) @db.Timestamptz(3)

  employee        Employee     @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  photoFile       StorageFile? @relation("AttendancePunchPhotoFile", fields: [photoFileId], references: [id], onDelete: SetNull)
  thumbnailFile   StorageFile? @relation("AttendancePunchThumbnailFile", fields: [thumbnailFileId], references: [id], onDelete: SetNull)
  startWorkShifts WorkShift[]  @relation("WorkShiftStartPunch")
  endWorkShifts   WorkShift[]  @relation("WorkShiftEndPunch")
  reviewedBy      User?        @relation(fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([employeeId, timestamp])
  @@index([status, timestamp])
  @@index([reviewStatus, timestamp])
  @@index([type, status])
  @@index([source])
  @@index([externalPunchId])
  @@index([photoFileId])
  @@index([thumbnailFileId])
}

model ClockPunchAttempt {
  id           String                  @id @default(uuid())
  requestId    String                  @unique
  employeeId   String
  punchType    AttendancePunchType
  status       ClockPunchAttemptStatus @default(PROCESSING)
  requestHash  String
  response     Json?
  errorCode    String?
  errorMessage String?
  httpStatus   Int?
  startedAt    DateTime                @default(now()) @db.Timestamptz(3)
  completedAt  DateTime?               @db.Timestamptz(3)
  updatedAt    DateTime                @updatedAt @db.Timestamptz(3)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([employeeId, startedAt])
  @@index([status, startedAt])
}

model TimeSegment {
  id                String               @id @default(uuid())
  workShiftId       String
  employeeId        String
  date              DateTime             @db.Date
  fromDateTime      DateTime             @db.Timestamptz(3)
  toDateTime        DateTime             @db.Timestamptz(3)
  minutes           Int
  hourConceptId     String
  hourConceptName   String
  isHoliday         Boolean              @default(false)
  isNight           Boolean              @default(false)
  isSpecial         Boolean              @default(false)
  // De qué HourConceptRule salió el concepto sugerido (null si fue manual o
  // si no hubo ninguna regla que matcheara el tramo) y qué pasó con esa
  // sugerencia — nunca bloquea la fichada, solo deja trazabilidad para RRHH.
  hourConceptRuleId String?
  conceptStatus     SegmentConceptStatus @default(MANUAL)
  source            String               @default("CALCULATED")
  observation       String?
  createdAt         DateTime             @default(now()) @db.Timestamptz(3)

  workShift                   WorkShift                    @relation(fields: [workShiftId], references: [id], onDelete: Cascade)
  employee                    Employee                     @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  hourConcept                 HourConcept                  @relation(fields: [hourConceptId], references: [id])
  hourConceptRule             HourConceptRule?             @relation(fields: [hourConceptRuleId], references: [id], onDelete: SetNull)
  timeEntries                 TimeEntry[]
  specialHourRuleApplications SpecialHourRuleApplication[]
  hourConceptBreakdowns       HourConceptBreakdown[]

  @@index([workShiftId])
  @@index([employeeId, date])
  @@index([hourConceptId])
}

// Desglose aditivo de un concepto horario adicional. Nunca representa Horas
// normales ni incrementa el total real trabajado. La lógica funcional que
// valida esa invariante y genera/carga desgloses se incorpora en etapas
// posteriores; Etapa 6C agrega únicamente la base persistente compatible.
model HourConceptBreakdown {
  id                String                     @id @default(uuid())
  employeeId        String
  date              DateTime                   @db.Date
  period            String
  day               Int
  hourConceptId     String
  minutes           Int
  source            HourConceptBreakdownSource
  status            ApprovalStatus             @default(BORRADOR)
  workShiftId       String?
  timeSegmentId     String?
  hourConceptRuleId String?
  observation       String?
  createdByUserId   String?
  approvedByUserId  String?
  approvedAt        DateTime?                  @db.Timestamptz(3)
  createdAt         DateTime                   @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                   @updatedAt @db.Timestamptz(3)

  employee        Employee         @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  hourConcept     HourConcept      @relation(fields: [hourConceptId], references: [id], onDelete: Restrict)
  workShift       WorkShift?       @relation(fields: [workShiftId], references: [id], onDelete: SetNull)
  timeSegment     TimeSegment?     @relation(fields: [timeSegmentId], references: [id], onDelete: SetNull)
  hourConceptRule HourConceptRule? @relation(fields: [hourConceptRuleId], references: [id], onDelete: SetNull)
  createdBy       User?            @relation("HourConceptBreakdownCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  approvedBy      User?            @relation("HourConceptBreakdownApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)

  // Los vínculos son opcionales para permitir cargas MANUAL. Cuando una fila
  // AUTOMATIC tenga segmento y regla, esta clave evita regenerar el mismo
  // desglose. La etapa funcional deberá exigir ambos vínculos para AUTOMATIC.
  @@unique([timeSegmentId, hourConceptRuleId, hourConceptId, source])
  @@index([employeeId, period])
  @@index([employeeId, date])
  @@index([hourConceptId, period])
  @@index([workShiftId])
  @@index([timeSegmentId])
  @@index([hourConceptRuleId])
  @@index([createdByUserId])
  @@index([approvedByUserId])
  @@index([period, status])
}

model DocumentCategory {
  id            String       @id @default(uuid())
  code          String       @unique
  name          String
  kind          String       @default("PERSONAL")
  status        RecordStatus @default(ACTIVO)
  description   String?
  scopes        Json         @default("[]")
  rules         Json         @default("{}")
  uploadRoles   Json         @default("[]")
  viewRoles     Json         @default("[]")
  approvalRoles Json         @default("[]")
  externalLinks Json         @default("[]")
  notes         String?
  createdAt     DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt     DateTime     @updatedAt @db.Timestamptz(3)

  documents EmployeeDocument[]

  @@index([status])
}

model AuditParameter {
  id                      String       @id @default(uuid())
  code                    String       @unique
  name                    String
  scope                   String
  severity                String
  status                  RecordStatus @default(ACTIVO)
  description             String
  trackCreate             Boolean      @default(true)
  trackUpdate             Boolean      @default(true)
  trackDeleteOrDeactivate Boolean      @default(false)
  trackApproval           Boolean      @default(false)
  trackExport             Boolean      @default(false)
  requiresReason          Boolean      @default(false)
  requiresEffectiveDate   Boolean      @default(false)
  visibleToRoles          Json         @default("[]")
  notification            Json         @default("{}")
  retention               Json         @default("{}")
  notes                   String?
  createdByUserId         String?
  createdByUserName       String?
  updatedByUserId         String?
  updatedByUserName       String?
  history                 Json         @default("[]")
  createdAt               DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt               DateTime     @updatedAt @db.Timestamptz(3)

  createdBy User? @relation("AuditParameterCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy User? @relation("AuditParameterUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([scope])
  @@index([severity])
  @@index([status])
}

model EmployeeDocument {
  id               String         @id @default(uuid())
  employeeId       String
  categoryId       String
  noveltyId        String?
  fileName         String
  fileMimeType     String
  fileSizeBytes    Int
  storageKey       String
  storageFileId    String?
  status           DocumentStatus @default(PENDIENTE)
  notes            String?
  issuedAt         DateTime?      @db.Date
  expiresAt        DateTime?      @db.Date
  uploadedByUserId String?
  createdAt        DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime       @updatedAt @db.Timestamptz(3)

  employee    Employee         @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  category    DocumentCategory @relation(fields: [categoryId], references: [id])
  novelty     Novelty?         @relation(fields: [noveltyId], references: [id])
  uploadedBy  User?            @relation(fields: [uploadedByUserId], references: [id])
  storageFile StorageFile?     @relation("EmployeeDocumentStorageFile", fields: [storageFileId], references: [id], onDelete: SetNull)

  @@index([employeeId])
  @@index([employeeId, createdAt])
  @@index([categoryId])
  @@index([status])
  @@index([status, expiresAt])
  @@index([status, createdAt])
  @@index([createdAt])
  @@index([storageFileId])
}

model StorageFile {
  id                  String            @id @default(uuid())
  storageProvider     StorageProvider
  storageKey          String
  driveFileId         String?
  driveFolderId       String?
  driveWebViewLink    String?
  driveWebContentLink String?
  fileName            String
  originalFileName    String
  mimeType            String
  extension           String
  sizeBytes           Int
  module              StorageModule
  entityType          StorageEntityType
  entityId            String
  employeeId          String?
  attendancePunchId   String?
  documentType        String?
  isThumbnail         Boolean           @default(false)
  thumbnailFileId     String?
  originalFileId      String?
  visibility          StorageVisibility @default(PRIVATE)
  status              StorageFileStatus @default(ACTIVE)
  uploadedByUserId    String?
  uploadedAt          DateTime          @default(now()) @db.Timestamptz(3)
  deletedByUserId     String?
  deletedAt           DateTime?         @db.Timestamptz(3)
  checksum            String?
  metadata            Json              @default("{}")
  createdAt           DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime          @updatedAt @db.Timestamptz(3)

  employee                      Employee?          @relation(fields: [employeeId], references: [id], onDelete: SetNull)
  uploadedBy                    User?              @relation("StorageFileUploadedBy", fields: [uploadedByUserId], references: [id], onDelete: SetNull)
  deletedBy                     User?              @relation("StorageFileDeletedBy", fields: [deletedByUserId], references: [id], onDelete: SetNull)
  employeeDocuments             EmployeeDocument[] @relation("EmployeeDocumentStorageFile")
  attendancePunchPhotoLinks     AttendancePunch[]  @relation("AttendancePunchPhotoFile")
  attendancePunchThumbnailLinks AttendancePunch[]  @relation("AttendancePunchThumbnailFile")

  @@index([storageProvider])
  @@index([storageKey])
  @@index([driveFileId])
  @@index([module, entityType, entityId])
  @@index([employeeId, module])
  @@index([attendancePunchId])
  @@index([status, uploadedAt])
}

model AuditLog {
  id          String      @id @default(uuid())
  action      AuditAction
  entity      String
  entityId    String?
  description String
  before      Json?
  after       Json?
  userId      String?
  ipAddress   String?
  userAgent   String?
  createdAt   DateTime    @default(now()) @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([entity, entityId, createdAt])
  @@index([userId])
  @@index([userId, createdAt])
  @@index([action, createdAt])
  @@index([createdAt])
}
