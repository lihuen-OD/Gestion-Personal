model TimeSegment {
  id                String               @id @default(uuid())
  workShiftId       String
  employeeId        String
  date              DateTime             @db.Date
  fromDateTime      DateTime             @db.Timestamptz(3)
  toDateTime        DateTime             @db.Timestamptz(3)
  minutes           Int
  hourConceptId     String
  hourConceptName   String
  isHoliday         Boolean              @default(false)
  isNight           Boolean              @default(false)
  isSpecial         Boolean              @default(false)
  // De qué HourConceptRule salió el concepto sugerido (null si fue manual o
  // si no hubo ninguna regla que matcheara el tramo) y qué pasó con esa
  // sugerencia — nunca bloquea la fichada, solo deja trazabilidad para RRHH.
  hourConceptRuleId String?
  conceptStatus     SegmentConceptStatus @default(MANUAL)
  source            String               @default("CALCULATED")
  observation       String?
  createdAt         DateTime             @default(now()) @db.Timestamptz(3)

  workShift                   WorkShift                    @relation(fields: [workShiftId], references: [id], onDelete: Cascade)
  employee                    Employee                     @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  hourConcept                 HourConcept                  @relation(fields: [hourConceptId], references: [id])
  hourConceptRule             HourConceptRule?             @relation(fields: [hourConceptRuleId], references: [id], onDelete: SetNull)
  timeEntries                 TimeEntry[]
  specialHourRuleApplications SpecialHourRuleApplication[]

  @@index([workShiftId])
  @@index([employeeId, date])
  @@index([hourConceptId])
}

