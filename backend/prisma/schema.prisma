  actualAt          DateTime           @db.Timestamptz(3)
  differenceMinutes Int?
  resolvedAt        DateTime?          @db.Timestamptz(3)
  resolvedByUserId  String?
  resolutionNote    String?
  createdAt         DateTime           @default(now()) @db.Timestamptz(3)
  employee          Employee           @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  workShift         WorkShift          @relation(fields: [workShiftId], references: [id], onDelete: Cascade)
  resolvedBy        User?              @relation(fields: [resolvedByUserId], references: [id], onDelete: SetNull)

  @@unique([workShiftId, type])
  @@index([employeeId, status, createdAt])
  @@index([severity, status])
}

model AttendanceInactivityIncident {
