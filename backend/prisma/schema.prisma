  reviewedBy User?    @relation("InactivityIncidentReviewedBy", fields: [reviewedByUserId], references: [id])

  @@unique([employeeId, operationalDate])
  @@index([status, operationalDate])
  @@index([employeeId, status])
}

model DoubleHourRule {
  id                          String                       @id @default(uuid())
  name                        String
  recurrenceType              RecurrenceType
  fromDate                    DateTime                     @db.Date
  toDate                      DateTime?                    @db.Date
  weekdays                    Int[]                        @default([])
  multiplier                  Decimal                      @default(2) @db.Decimal(4, 2)
  status                      RecordStatus                 @default(ACTIVO)
  reason                      String
  createdByUserId             String?
  createdAt                   DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt                   DateTime                     @updatedAt @db.Timestamptz(3)
  employees                   DoubleHourRuleEmployee[]
  createdBy                   User?                        @relation(fields: [createdByUserId], references: [id], onDelete: SetNull)
  specialHourRuleApplications SpecialHourRuleApplication[]

  @@index([status, fromDate, toDate])
}

model DoubleHourRuleEmployee {
  ruleId     String
  employeeId String
  rule       DoubleHourRule @relation(fields: [ruleId], references: [id], onDelete: Cascade)
  employee   Employee       @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@id([ruleId, employeeId])
  @@index([employeeId])
}

// Trazabilidad de qué DoubleHourRule aplicó a qué TimeSegment. No reemplaza
// a DoubleHourRule (que sigue siendo el motor de reglas especiales) — registra
// TODAS las reglas que matchearon un segmento, aunque en V1 el multiplicador
// efectivo que se lleva a TimeEntry.appliedMultiplier sea el máximo entre
// ellas (nunca se acumulan/multiplican entre sí todavía; esa selección es
// lógica de servicio de la próxima etapa, no de este modelo).
model SpecialHourRuleApplication {
  id                String   @id @default(uuid())
  timeSegmentId     String
  doubleHourRuleId  String
  multiplierApplied Decimal  @db.Decimal(4, 2)
  createdAt         DateTime @default(now()) @db.Timestamptz(3)

  timeSegment    TimeSegment    @relation(fields: [timeSegmentId], references: [id], onDelete: Cascade)
  doubleHourRule DoubleHourRule @relation(fields: [doubleHourRuleId], references: [id], onDelete: Restrict)

  @@index([timeSegmentId])
}

model AttendancePunch {
