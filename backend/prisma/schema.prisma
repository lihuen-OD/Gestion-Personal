  employee      Employee      @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  shiftTemplate ShiftTemplate @relation(fields: [shiftTemplateId], references: [id], onDelete: Cascade)
  assignedBy    User?         @relation("ShiftAssignmentAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)
  disabledBy    User?         @relation("ShiftAssignmentDisabledBy", fields: [disabledByUserId], references: [id], onDelete: SetNull)

  @@unique([employeeId, shiftTemplateId])
  @@index([employeeId, status])
  @@index([shiftTemplateId, status])
}

enum HolidayWorkAssignmentStatus {
  ACTIVA
  CANCELADA
}

// Etapa 12D: registra que un empleado fue convocado a trabajar un feriado
// puntual. `date` es un valor propio (no una FK a SpecialHourRuleDate ni a
// ninguna tabla de Horas Especiales) — las fechas disponibles para crear
// asignaciones se resuelven en tiempo de lectura desde
// DoubleHourRule.kind=FERIADO (ver workforceService.holidayDatesInRange,
// docs/decisions/SPECIAL_HOUR_RULE_CLASSIFICATION_12A.md §12) y nunca se
// copian/duplican acá — esta tabla no es un calendario paralelo, sólo
// referencia por valor la fecha que ya salió de esa fuente única.
// No guarda multiplier, regla de liquidación ni horas liquidables: define
// únicamente la EXPECTATIVA de quién debía trabajar (convocatoria), nunca
// cuánto vale si trabaja — eso lo sigue resolviendo Horas Especiales.
// `@@unique([date, employeeId])`: sólo puede existir una fila por persona y
// fecha, para siempre (igual criterio que ShiftAssignment/DoubleHourRuleEmployee
// con su unique compuesto) — "sacar" a alguien de la convocatoria no borra
// la fila ni permite crear una segunda, la deja en `status=CANCELADA` (mismo
// patrón reEnable/DESHABILITADO ya usado en ShiftAssignment).
model HolidayWorkAssignment {
  id                String                       @id @default(uuid())
  date              DateTime                     @db.Date
  employeeId        String
  shiftTemplateId   String?
  expectedStartTime String?
  expectedEndTime   String?
  notes             String?
  status            HolidayWorkAssignmentStatus  @default(ACTIVA)
  createdByUserId   String?
  updatedByUserId   String?
  createdAt         DateTime                     @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime                     @updatedAt @db.Timestamptz(3)

  employee      Employee       @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  shiftTemplate ShiftTemplate? @relation(fields: [shiftTemplateId], references: [id], onDelete: SetNull)
  createdBy     User?          @relation("HolidayWorkAssignmentCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy     User?          @relation("HolidayWorkAssignmentUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@unique([date, employeeId])
  @@index([date, status])
  @@index([employeeId])
}

// Régimen de trabajo: comportamiento genérico (3 kinds fijos). Los nombres
// concretos (Cosecha, Riego, Campaña, Jornada libre controlada, etc.) son
// instancias configurables por RRHH, nunca valores de enum ni lógica
// hardcodeada. alertOnOutOfShift decide si "fuera de turno"/"sin turno" debe
// alertar para este régimen (ver EmployeeWorkRegime para la asignación).
model WorkRegime {
  id                        String                  @id @default(uuid())
  code                      String                  @unique
  name                      String
  kind                      WorkRegimeKind
  alertOnOutOfShift         Boolean                 @default(true)
  openShiftOverflowAction   OpenShiftOverflowAction @default(ROLLOVER)
  // Etapa 10D: umbral (en minutos) que, si está seteado, reemplaza a
  // ShiftTemplate.maximumInformativeMinutes para decidir JORNADA_EXTENDIDA —
  // nunca al revés (el turno nunca gana sobre un régimen que sí lo define).
  // null = comportamiento actual sin cambios (usa el umbral del turno, o el
  // default de 600 min si no hay turno). Ver workShiftEvaluation.service.ts.
  extendedShiftAlertMinutes Int?
  description               String?
  status                    RecordStatus            @default(ACTIVO)
  createdByUserId           String?
  updatedByUserId           String?
  createdAt                 DateTime                @default(now()) @db.Timestamptz(3)
  updatedAt                 DateTime                @updatedAt @db.Timestamptz(3)

  createdBy           User?                @relation("WorkRegimeCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy           User?                @relation("WorkRegimeUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  employeeAssignments EmployeeWorkRegime[]

  @@index([status])
  @@index([kind])
}

// Régimen vigente de un empleado, resuelto por fecha (mismo patrón que
// Employee.status se deriva de LaborMovement) — no un booleano simple, para
// que un empleado pueda pasar de un régimen a otro estacionalmente sin perder
// historial. Restrict en ambas FK: no perder trazabilidad si se intenta
// inactivar/borrar un Employee o un WorkRegime con asignaciones existentes.
model EmployeeWorkRegime {
  id               String    @id @default(uuid())
  employeeId       String
  workRegimeId     String
  effectiveFrom    DateTime  @db.Date
  effectiveTo      DateTime? @db.Date
  assignedByUserId String?
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)

  employee   Employee   @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  workRegime WorkRegime @relation(fields: [workRegimeId], references: [id], onDelete: Restrict)
  assignedBy User?      @relation(fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@index([employeeId, effectiveFrom])
  // Usado por GET /work-regimes/:id/employees (Etapa 8G/8H): filtra por
  // workRegimeId (igualdad) y por vigencia (rango sobre effectiveFrom). No se
  // agrega effectiveTo a este índice — con workRegimeId como igualdad líder,
  // una tercera columna después de un rango sobre effectiveFrom no reduce el
  // escaneo del índice, solo evitaría un fetch a la fila para ese filtro
  // puntual; no se justifica sobreindexar por esa ganancia marginal.
  @@index([workRegimeId, effectiveFrom])
}

