generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  NIVEL_1_RRHH
  NIVEL_2_SUPERVISION
  NIVEL_3_CARGA_HORARIA
}

enum RecordStatus {
  ACTIVO
  INACTIVO
}

enum EmployeeStatus {
  ACTIVO
  INACTIVO
}

enum LaborMovementType {
  ALTA
  BAJA
}

enum NoveltyTypeKind {
  AUSENCIA
  LICENCIA
  HORARIA
  ACCIDENTE
  VACACIONES
  SANCION
  OTRO
}

enum NoveltyTypeOrigin {
  INTERNA
  FINNEGANS
  MIXTA
}

enum NoveltyTimeImpact {
  NO_AFECTA_HORAS
  REGISTRA_HORAS_NO_TRABAJADAS
  BLOQUEA_CARGA_DIA
}

enum ApprovalStatus {
  BORRADOR
  PENDIENTE
  EN_REVISION
  APROBADO
  RECHAZADO
  DEVUELTO
  CERRADO
}

enum WorkShiftStatus {
  ABIERTO
  PROCESADO
  OBSERVADO
  ANULADO
  FALTA_SALIDA
  FALTA_INGRESO
  INVALIDO
  REVISADO
  CERRADO_MANUAL
}

enum WorkShiftSource {
  ADMIN
  PORTAL_DNI
  PUBLIC_CLOCK_PHOTO
  KIOSK
  BIOTIME
  FACIAL
}

enum AttendancePunchType {
  INGRESO
  SALIDA
}

enum AttendancePunchStatus {
  VALIDA
  OBSERVADA
  RECHAZADA
}

enum AttendanceReviewStatus {
  PENDIENTE
  RESUELTA
  DESCARTADA
}

enum FaceValidationStatus {
  VALID
  NO_FACE
  MULTIPLE_FACES
  LOW_LIGHT
  FACE_TOO_SMALL
  CAMERA_ERROR
}

enum ClockPunchAttemptStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum StorageProvider {
  LOCAL
  CLOUDINARY
  GOOGLE_DRIVE
}

enum StorageModule {
  FICHADAS
  LEGAJOS
  NOVEDADES
  TRANSPORTE
  AUDITORIA
  DOCUMENTACION_GENERAL
}

enum StorageEntityType {
  ATTENDANCE_PUNCH
  EMPLOYEE
  EMPLOYEE_DOCUMENT
  ABSENCE
  TRANSPORT
  AUDIT_EVENT
  GENERAL_DOCUMENT
}

enum StorageVisibility {
  PRIVATE
  RRHH_ONLY
  SUPERVISOR_ALLOWED
  SYSTEM_ONLY
}

enum StorageFileStatus {
  ACTIVE
  ARCHIVED
  DELETED
  ERROR
}

enum HourConceptKind {
  NORMAL
  EXTRA
  NOCTURNA
  GUARDIA
  SERENO
  TRANSPORTE
  FERIADO
  OTRO
}

enum HourConceptLoadMode {
  MANUAL
  AUTOMATIC
  BOTH
}

enum HourConceptSystemRole {
  NORMAL_BASE
}

enum HourConceptBreakdownSource {
  MANUAL
  AUTOMATIC
}

enum DocumentStatus {
  PENDIENTE
  VIGENTE
  POR_VENCER
  VENCIDO
  RECHAZADO
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  ACTIVATE
  DEACTIVATE
  APPROVE
  REJECT
  RETURN
  LOGIN
  EXPORT
}

enum MonthlyClosureStatus {
  ABIERTO
  ENVIADO
  APROBADO
  DEVUELTO
  CORRECCION_PENDIENTE
}

enum CorrectionRequestStatus {
  PENDIENTE
  APROBADA
  RECHAZADA
}

enum NotificationStatus {
  NO_LEIDA
  LEIDA
}

enum ShiftAlertType {
  INGRESO_TARDE
  SALIDA_ANTICIPADA
  SALIDA_TARDIA
  TURNO_NO_IDENTIFICADO
  SHIFT_NOT_ENABLED_FOR_EMPLOYEE
  POSSIBLE_SHIFT_CONFIGURATION_MISSING
  JORNADA_INSUFICIENTE
  JORNADA_EXTENDIDA
  DESCANSO_INSUFICIENTE
  POSIBLE_OLVIDO_SALIDA
  CONCEPTO_NO_HABILITADO
  SEGMENTO_SIN_CLASIFICAR
  // Etapa 13A: ingreso registrado antes del horario/tolerancia del turno
  // asignado del empleado (nunca se genera por comparación contra un turno
  // ajeno — ver docs/decisions/SHIFT_ENTRY_CLASSIFICATION_13A.md).
  INGRESO_ANTICIPADO
}

enum ShiftAlertStatus {
  PENDIENTE
  RESUELTA
  DESCARTADA
}

enum ShiftAlertSeverity {
  INFO
  ADVERTENCIA
  CRITICA
}

enum ShiftAssignmentStatus {
  HABILITADO
  DESHABILITADO
}

enum RecurrenceType {
  FECHA
  RANGO
  SEMANAL
}

// Etapa 12B: clasificación estructurada de una DoubleHourRule — nunca se
// infiere del nombre libre (`DoubleHourRule.name`), que sigue siendo sólo
// texto visible. Sólo FERIADO alimentará la futura pantalla de asignaciones
// de trabajo en feriados de Turnos (ver docs/decisions/
// SPECIAL_HOUR_RULE_CLASSIFICATION_12A.md). Default OTRO: las reglas
// existentes nunca se reclasifican por adivinanza de nombre, quedan en OTRO
// hasta que RRHH las reclasifique explícitamente desde la UI.
enum DoubleHourRuleKind {
  FERIADO
  DOMINGO
  JORNADA_ESPECIAL
  OTRO
}

// Comportamientos genéricos, no nombres de cliente. Instancias concretas
// (Cosecha, Riego, Campaña, Jornada libre controlada, etc.) son datos
// configurables de WorkRegime, nunca valores de este enum.
enum WorkRegimeKind {
  TURNO_OBLIGATORIO
  TURNO_FLEXIBLE
  SIN_TURNO
}

// Qué hacer cuando una WorkShift abierta supera el límite operativo
// (WorkShift.maxAllowedMinutes). ROLLOVER conserva el comportamiento
// histórico (cierra la jornada como FALTA_SALIDA y habilita una nueva).
// ALERT_ONLY no corta nada automáticamente: genera alerta crítica y deja la
// jornada para revisión de RRHH. Cosecha/Riego/Campaña, etc. siguen siendo
// instancias configurables de WorkRegime — este enum no las nombra.
enum OpenShiftOverflowAction {
  ROLLOVER
  ALERT_ONLY
}

enum SegmentConceptStatus {
  SUGERIDO
  MANUAL
  SIN_CONCEPTO_COMPATIBLE
  CONCEPTO_NO_HABILITADO
}

model User {
  id                  String       @id @default(uuid())
  name                String
  email               String       @unique
  passwordHash        String
  refreshTokenVersion Int          @default(0)
  role                RoleName
  status              RecordStatus @default(ACTIVO)
  companyId           String?
  sectorId            String?
  employeeId          String?      @unique
  createdAt           DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime     @updatedAt @db.Timestamptz(3)

  company                       Company?                       @relation(fields: [companyId], references: [id])
  sector                        Sector?                        @relation(fields: [sectorId], references: [id])
  employee                      Employee?                      @relation("EmployeeUserAccount", fields: [employeeId], references: [id])
  createdEmployees              Employee[]                     @relation("EmployeeCreatedBy")
  employeeAssignments           EmployeeAssignment[]
  laborMovements                LaborMovement[]
  fieldHistory                  EmployeeFieldHistory[]
  blockHistory                  EmployeeBlockHistory[]
  noveltiesCreated              Novelty[]                      @relation("NoveltyCreatedBy")
  timeEntriesCreated            TimeEntry[]                    @relation("TimeEntryCreatedBy")
  hourConceptBreakdownsCreated  HourConceptBreakdown[]         @relation("HourConceptBreakdownCreatedBy")
  documentsUploaded             EmployeeDocument[]
  storageFilesUploaded          StorageFile[]                  @relation("StorageFileUploadedBy")
  storageFilesDeleted           StorageFile[]                  @relation("StorageFileDeletedBy")
  auditLogs                     AuditLog[]
  notifications                 SystemNotification[]           @relation("NotificationRecipient")
  closuresSubmitted             MonthlyTimeClosure[]           @relation("ClosureSubmittedBy")
  closuresReviewed              MonthlyTimeClosure[]           @relation("ClosureReviewedBy")
  correctionsCreated            TimeCorrectionRequest[]        @relation("CorrectionCreatedBy")
  correctionsReviewed           TimeCorrectionRequest[]        @relation("CorrectionReviewedBy")
  inactivityIncidentsReviewed   AttendanceInactivityIncident[] @relation("InactivityIncidentReviewedBy")
  noveltiesApproved             Novelty[]                      @relation("NoveltyApprovedBy")
  timeEntriesApproved           TimeEntry[]                    @relation("TimeEntryApprovedBy")
  hourConceptBreakdownsApproved HourConceptBreakdown[]         @relation("HourConceptBreakdownApprovedBy")
  workShiftsCreated             WorkShift[]                    @relation("WorkShiftCreatedBy")
  workShiftsReviewed            WorkShift[]                    @relation("WorkShiftReviewedBy")
  shiftTemplatesCreated         ShiftTemplate[]                @relation("ShiftTemplateCreatedBy")
  shiftTemplatesUpdated         ShiftTemplate[]                @relation("ShiftTemplateUpdatedBy")
  shiftAssignmentsAssigned      ShiftAssignment[]              @relation("ShiftAssignmentAssignedBy")
  shiftAssignmentsDisabled      ShiftAssignment[]              @relation("ShiftAssignmentDisabledBy")
  holidayWorkAssignmentsCreated HolidayWorkAssignment[]        @relation("HolidayWorkAssignmentCreatedBy")
  holidayWorkAssignmentsUpdated HolidayWorkAssignment[]        @relation("HolidayWorkAssignmentUpdatedBy")
  shiftAlertsResolved           ShiftAlert[]
  doubleHourRulesCreated        DoubleHourRule[]
  attendancePunchesReviewed     AttendancePunch[]
  auditParametersCreated        AuditParameter[]               @relation("AuditParameterCreatedBy")
  auditParametersUpdated        AuditParameter[]               @relation("AuditParameterUpdatedBy")
  workRegimesCreated            WorkRegime[]                   @relation("WorkRegimeCreatedBy")
  workRegimesUpdated            WorkRegime[]                   @relation("WorkRegimeUpdatedBy")
  workRegimesAssigned           EmployeeWorkRegime[]

  @@index([role])
  @@index([status])
}

model Company {
  id        String       @id @default(uuid())
  name      String       @unique
  code      String       @unique
  status    RecordStatus @default(ACTIVO)
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @db.Timestamptz(3)

  users           User[]
  businessUnits   BusinessUnit[]
  establishments  Establishment[]
  employees       EmployeeCompany[]
  costCenterLinks CostCenterCompany[]
  doubleHourRules DoubleHourRule[]
}

model BusinessUnit {
  id        String       @id @default(uuid())
  name      String
  code      String
  status    RecordStatus @default(ACTIVO)
  companyId String
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @db.Timestamptz(3)

  company         Company                  @relation(fields: [companyId], references: [id])
  establishments  Establishment[]
  costCenterLinks CostCenterBusinessUnit[]

  @@unique([companyId, code])
  @@index([companyId])
}

model Establishment {
  id             String       @id @default(uuid())
  name           String
  code           String
  status         RecordStatus @default(ACTIVO)
  companyId      String
  businessUnitId String?
  province       String?
  department     String?
  city           String?
  street         String?
  streetNumber   String?
  postalCode     String?
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)

  company         Company                   @relation(fields: [companyId], references: [id])
  businessUnit    BusinessUnit?             @relation(fields: [businessUnitId], references: [id])
  areas           Area[]
  costCenterLinks CostCenterEstablishment[]

  @@unique([companyId, code])
  @@index([businessUnitId])
}

model Area {
  id              String       @id @default(uuid())
  name            String
  code            String       @unique
  status          RecordStatus @default(ACTIVO)
  establishmentId String?
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(3)

  establishment   Establishment?   @relation(fields: [establishmentId], references: [id])
  sectors         Sector[]
  costCenterLinks CostCenterArea[]

  @@index([establishmentId])
}

model Sector {
  id        String       @id @default(uuid())
  name      String
  code      String       @unique
  status    RecordStatus @default(ACTIVO)
  areaId    String?
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @db.Timestamptz(3)

  area            Area?              @relation(fields: [areaId], references: [id])
  users           User[]
  employees       Employee[]
  positions       Position[]
  costCenterLinks CostCenterSector[]
  doubleHourRules DoubleHourRule[]

  @@index([areaId])
}

model CostCenter {
  id        String       @id @default(uuid())
  name      String
  code      String       @unique
  status    RecordStatus @default(ACTIVO)
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @db.Timestamptz(3)

  employees       Employee[]
  companies       CostCenterCompany[]
  businessUnits   CostCenterBusinessUnit[]
  establishments  CostCenterEstablishment[]
  areas           CostCenterArea[]
  sectors         CostCenterSector[]
  doubleHourRules DoubleHourRule[]
}

model CostCenterCompany {
  costCenterId String
  companyId    String

  costCenter CostCenter @relation(fields: [costCenterId], references: [id], onDelete: Cascade)
  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([costCenterId, companyId])
  @@index([companyId])
}

model CostCenterBusinessUnit {
  costCenterId   String
  businessUnitId String

  costCenter   CostCenter   @relation(fields: [costCenterId], references: [id], onDelete: Cascade)
  businessUnit BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)

  @@id([costCenterId, businessUnitId])
  @@index([businessUnitId])
}

model CostCenterEstablishment {
  costCenterId    String
  establishmentId String

  costCenter    CostCenter    @relation(fields: [costCenterId], references: [id], onDelete: Cascade)
  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@id([costCenterId, establishmentId])
  @@index([establishmentId])
}

model CostCenterArea {
  costCenterId String
  areaId       String

  costCenter CostCenter @relation(fields: [costCenterId], references: [id], onDelete: Cascade)
  area       Area       @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@id([costCenterId, areaId])
  @@index([areaId])
}

model CostCenterSector {
  costCenterId String
  sectorId     String

  costCenter CostCenter @relation(fields: [costCenterId], references: [id], onDelete: Cascade)
  sector     Sector     @relation(fields: [sectorId], references: [id], onDelete: Cascade)

  @@id([costCenterId, sectorId])
  @@index([sectorId])
}

model SalaryCategory {
  id        String       @id @default(uuid())
  name      String       @unique
  family    String?
  order     Int
  status    RecordStatus @default(ACTIVO)
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @db.Timestamptz(3)

  positions PositionSalaryCategory[]

  @@index([status])
}

model Position {
  id                    String       @id @default(uuid())
  code                  String       @unique
  name                  String
  status                RecordStatus @default(ACTIVO)
  mission               String?
  description           String?
  lastUpdatedAt         DateTime?    @db.Timestamptz(3)
  responsibilities      Json?
  internalRelations     Json?
  externalRelations     Json?
  competencies          Json?
  workConditions        Json?
  performanceIndicators Json?
  evaluationCriteria    Json?
  sectorId              String?
  createdAt             DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime     @updatedAt @db.Timestamptz(3)

  sector           Sector?                  @relation(fields: [sectorId], references: [id])
  employees        Employee[]
  salaryCategories PositionSalaryCategory[]
  doubleHourRules  DoubleHourRule[]

  @@index([sectorId])
  @@index([status])
}

model PositionSalaryCategory {
  positionId       String
  salaryCategoryId String

  position       Position       @relation(fields: [positionId], references: [id], onDelete: Cascade)
  salaryCategory SalaryCategory @relation(fields: [salaryCategoryId], references: [id], onDelete: Cascade)

  @@id([positionId, salaryCategoryId])
}

model Employee {
  id                String         @id @default(uuid())
  legajo            String         @unique
  legajoFinnegans   String?
  cuil              String         @unique
  dni               String         @unique
  firstName         String
  lastName          String
  birthDate         DateTime?      @db.Date
  gender            String?
  civilStatus       String?
  nationality       String?
  email             String?
  phone             String?
  mobile            String?
  emergencyContact  String?
  emergencyRelation String?
  emergencyPhone    String?
  status            EmployeeStatus @default(ACTIVO)
  positionId        String?
  sectorId          String?
  costCenterId      String?
  healthInsurance   String?
  agreement         String?
  receiptCategory   String?
  internalCategory  String?
  createdByUserId   String?
  createdAt         DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @db.Timestamptz(3)

  position              Position?                      @relation(fields: [positionId], references: [id])
  sector                Sector?                        @relation(fields: [sectorId], references: [id])
  costCenter            CostCenter?                    @relation(fields: [costCenterId], references: [id])
  createdBy             User?                          @relation("EmployeeCreatedBy", fields: [createdByUserId], references: [id])
  address               EmployeeAddress?
  companies             EmployeeCompany[]
  laborMovements        LaborMovement[]
  assignments           EmployeeAssignment[]
  hourConcepts          EmployeeHourConcept[]
  transport             EmployeeTransport?
  fieldHistory          EmployeeFieldHistory[]
  blockHistory          EmployeeBlockHistory[]
  novelties             Novelty[]
  timeEntries           TimeEntry[]
  hourConceptBreakdowns HourConceptBreakdown[]
  workShifts            WorkShift[]
  attendancePunches     AttendancePunch[]
  clockPunchAttempts    ClockPunchAttempt[]
  timeSegments          TimeSegment[]
  documents             EmployeeDocument[]
  storageFiles          StorageFile[]
  monthlyClosures       MonthlyTimeClosure[]
  correctionRequests    TimeCorrectionRequest[]
  shiftAlerts           ShiftAlert[]
  inactivityIncidents   AttendanceInactivityIncident[]
  doubleHourAssignments DoubleHourRuleEmployee[]
  shiftAssignments      ShiftAssignment[]
  holidayWorkAssignments HolidayWorkAssignment[]
  workRegimeAssignments EmployeeWorkRegime[]
  userAccount           User?                          @relation("EmployeeUserAccount")

  @@index([lastName, firstName])
  @@index([status])
  @@index([status, lastName, firstName])
  @@index([status, sectorId])
  @@index([status, costCenterId])
  @@index([sectorId])
  @@index([costCenterId])
}

model EmployeeCompany {
  employeeId String
  companyId  String
  isPrimary  Boolean @default(false)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([employeeId, companyId])
  @@index([companyId])
  @@index([companyId, employeeId])
}

model EmployeeAddress {
  id           String   @id @default(uuid())
  employeeId   String   @unique
  province     String?
  department   String?
  city         String?
  street       String?
  streetNumber String?
  postalCode   String?
  latitude     Decimal? @db.Decimal(10, 7)
  longitude    Decimal? @db.Decimal(10, 7)
  mapLabel     String?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
}

model EmployeeTransport {
  id                   String   @id @default(uuid())
  employeeId           String   @unique
  usesCompanyTransport Boolean  @default(false)
  locality             String?
  pickupAddress        String?
  pickupReference      String?
  busLine              String?
  schedule             String?
  observation          String?
  createdAt            DateTime @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @db.Timestamptz(3)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([usesCompanyTransport])
}

model LaborMovement {
  id              String            @id @default(uuid())
  employeeId      String
  type            LaborMovementType
  effectiveFrom   DateTime          @db.Date
  reason          String
  observation     String?
  createdByUserId String?
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)

  employee  Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  createdBy User?    @relation(fields: [createdByUserId], references: [id])

  @@index([employeeId, effectiveFrom])
  @@index([employeeId, type])
  @@index([type, effectiveFrom, employeeId])
}

model EmployeeAssignment {
  id            String    @id @default(uuid())
  employeeId    String
  userId        String?
  personName    String?
  type          String
  role          String?
  effectiveFrom DateTime? @db.Date
  effectiveTo   DateTime? @db.Date
  status        String?
  notes         String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  user     User?    @relation(fields: [userId], references: [id])

  @@index([employeeId, type])
  @@index([userId])
}

model HourConcept {
  id             String                 @id @default(uuid())
  code           String                 @unique
  name           String
  kind           HourConceptKind
  status         RecordStatus           @default(ACTIVO)
  countsAsWorked Boolean                @default(true)
  // Etapa 6C: nullable para no asignar semántica nueva a conceptos legacy.
  // En etapas posteriores será obligatorio para conceptos adicionales;
  // Horas normales no usa HourConceptBreakdown.
  loadMode       HourConceptLoadMode?
  // Rol estable reservado al concepto base del sistema. Es nullable porque
  // todos los demás conceptos son adicionales; @unique garantiza que exista
  // como máximo un NORMAL_BASE sin depender de code/name/kind mutables.
  systemRole     HourConceptSystemRole? @unique
  // Eliminación lógica (Etapa 8P): se usa SOLO cuando el concepto tiene uso
  // histórico real (TimeEntry/TimeSegment tienen FK obligatoria — Postgres
  // rechaza el delete físico mientras existan filas, y aunque no las
  // hubiera, Novelty.targetHourConceptId no tiene snapshot de nombre y
  // perdería la trazabilidad). No se toca TimeEntry/TimeSegment/WorkShift/
  // Novelty nunca: la fila de HourConcept sigue existiendo físicamente, así
  // que todos sus joins históricos siguen resolviendo igual. deletedAt
  // != null es lo que la UI usa para ocultarlo del catálogo activo; status
  // ya vuelve a INACTIVO al mismo tiempo (misma semántica que "deshabilitado"
  // para el fichador/clasificación, que ya filtran por status ACTIVO).
  deletedAt      DateTime?              @db.Timestamptz(3)
  createdAt      DateTime               @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime               @updatedAt @db.Timestamptz(3)

  employees    EmployeeHourConcept[]
  timeEntries  TimeEntry[]
  novelties    Novelty[]
  timeSegments TimeSegment[]
  workShifts   WorkShift[]
  rules        HourConceptRule[]
  breakdowns   HourConceptBreakdown[]

  @@index([status])
}

model EmployeeHourConcept {
  employeeId    String
  hourConceptId String

  employee    Employee    @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  hourConcept HourConcept @relation(fields: [hourConceptId], references: [id], onDelete: Cascade)

  @@id([employeeId, hourConceptId])
  // La PK compuesta (employeeId, hourConceptId) no cubre eficientemente una
  // búsqueda por hourConceptId solo (regla del prefijo izquierdo de btree) —
  // este índice es lo que usa GET /hour-concepts/:id/employees (Etapa 8G/8H).
  @@index([hourConceptId])
}

// Regla de sugerencia (no de bloqueo): en qué rango horario un HourConcept
// aplica por defecto, para partir automáticamente una jornada real en
// segmentos (ej. Guardia 21:00-04:00). Si un tramo no matchea ninguna regla,
// el segmento queda con conceptStatus = SIN_CONCEPTO_COMPATIBLE, nunca bloquea
// la fichada. Los horarios reales del cliente son datos de instancia
// (seed/demo/testing), nunca valores fijos en el backend.
model HourConceptRule {
  id              String       @id @default(uuid())
  hourConceptId   String
  startTime       String
  endTime         String
  crossesMidnight Boolean      @default(false)
  priority        Int          @default(0)
  status          RecordStatus @default(ACTIVO)
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(3)

  hourConcept  HourConcept            @relation(fields: [hourConceptId], references: [id], onDelete: Cascade)
  timeSegments TimeSegment[]
  breakdowns   HourConceptBreakdown[]

  @@index([hourConceptId, status])
}

model EmployeeFieldHistory {
  id              String   @id @default(uuid())
  employeeId      String
  section         String
  field           String
  fieldLabel      String
  oldValue        String?
  newValue        String
  effectiveFrom   DateTime @db.Date
  reason          String
  createdByUserId String?
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  employee  Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
