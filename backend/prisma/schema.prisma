  reviewedBy    User?            @relation("WorkShiftReviewedBy", fields: [reviewedByUserId], references: [id], onDelete: SetNull)

  @@index([employeeId, startAt])
  @@index([hourConceptId])
  @@index([employeeId, endAt])
  @@index([status, startAt])
  @@index([startAt, endAt])
  @@index([startPunchId])
  @@index([endPunchId])
  @@index([status])
  @@index([reviewStatus, startAt])
  @@index([source])
  @@index([shiftTemplateId])
}

model MonthlyTimeClosure {
