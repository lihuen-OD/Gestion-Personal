generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum RoleName {
  NIVEL_1_RRHH
  NIVEL_2_SUPERVISION
  NIVEL_3_CARGA_HORARIA
}

enum RecordStatus {
  ACTIVO
  INACTIVO
}

enum EmployeeStatus {
  ACTIVO
  INACTIVO
}

enum LaborMovementType {
  ALTA
  BAJA
}

enum NoveltyTypeKind {
  AUSENCIA
  LICENCIA
  HORARIA
  ACCIDENTE
  VACACIONES
  SANCION
  OTRO
}

enum NoveltyTypeOrigin {
  INTERNA
  FINNEGANS
  MIXTA
}

enum NoveltyTimeImpact {
  NO_AFECTA_HORAS
  REGISTRA_HORAS_NO_TRABAJADAS
  BLOQUEA_CARGA_DIA
}

enum ApprovalStatus {
  BORRADOR
  PENDIENTE
  EN_REVISION
  APROBADO
  RECHAZADO
  DEVUELTO
  CERRADO
}

enum WorkShiftStatus {
  ABIERTO
  PROCESADO
  OBSERVADO
  ANULADO
  FALTA_SALIDA
  FALTA_INGRESO
  INVALIDO
  REVISADO
  CERRADO_MANUAL
}

enum WorkShiftSource {
  ADMIN
  PORTAL_DNI
  PUBLIC_CLOCK_PHOTO
  KIOSK
  BIOTIME
  FACIAL
}

enum AttendancePunchType {
  INGRESO
  SALIDA
}

enum AttendancePunchStatus {
  VALIDA
  OBSERVADA
  RECHAZADA
}

enum AttendanceReviewStatus {
  PENDIENTE
  RESUELTA
  DESCARTADA
}

enum FaceValidationStatus {
  VALID
  NO_FACE
  MULTIPLE_FACES
  LOW_LIGHT
  FACE_TOO_SMALL
  CAMERA_ERROR
}

enum ClockPunchAttemptStatus {
  PROCESSING
  COMPLETED
  FAILED
}

enum StorageProvider {
  LOCAL
  CLOUDINARY
  GOOGLE_DRIVE
}

enum StorageModule {
  FICHADAS
  LEGAJOS
  NOVEDADES
  TRANSPORTE
  AUDITORIA
  DOCUMENTACION_GENERAL
}

enum StorageEntityType {
  ATTENDANCE_PUNCH
  EMPLOYEE
  EMPLOYEE_DOCUMENT
  ABSENCE
  TRANSPORT
  AUDIT_EVENT
  GENERAL_DOCUMENT
}

enum StorageVisibility {
  PRIVATE
  RRHH_ONLY
  SUPERVISOR_ALLOWED
  SYSTEM_ONLY
}

enum StorageFileStatus {
  ACTIVE
  ARCHIVED
  DELETED
  ERROR
}

enum HourConceptKind {
  NORMAL
  EXTRA
  NOCTURNA
  GUARDIA
  SERENO
  TRANSPORTE
  FERIADO
  OTRO
}

enum DocumentStatus {
  PENDIENTE
  VIGENTE
  POR_VENCER
  VENCIDO
  RECHAZADO
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  ACTIVATE
  DEACTIVATE
  APPROVE
  REJECT
  RETURN
  LOGIN
  EXPORT
}

enum MonthlyClosureStatus {
  ABIERTO
  ENVIADO
  APROBADO
  DEVUELTO
  CORRECCION_PENDIENTE
}

enum CorrectionRequestStatus {
  PENDIENTE
  APROBADA
  RECHAZADA
}

enum NotificationStatus {
  NO_LEIDA
  LEIDA
}

enum ShiftAlertType {
  INGRESO_TARDE
  SALIDA_ANTICIPADA
  SALIDA_TARDIA
  TURNO_NO_IDENTIFICADO
  SHIFT_NOT_ENABLED_FOR_EMPLOYEE
  POSSIBLE_SHIFT_CONFIGURATION_MISSING
  JORNADA_INSUFICIENTE
  JORNADA_EXTENDIDA
  DESCANSO_INSUFICIENTE
  POSIBLE_OLVIDO_SALIDA
  CONCEPTO_NO_HABILITADO
  SEGMENTO_SIN_CLASIFICAR
}

enum ShiftAlertStatus {
  PENDIENTE
  RESUELTA
  DESCARTADA
}

enum ShiftAlertSeverity {
  INFO
  ADVERTENCIA
  CRITICA
}

enum ShiftAssignmentStatus {
  HABILITADO
  DESHABILITADO
}

enum RecurrenceType {
  FECHA
  RANGO
  SEMANAL
}

// Comportamientos genéricos, no nombres de cliente. Instancias concretas
// (Cosecha, Riego, Campaña, Jornada libre controlada, etc.) son datos
// configurables de WorkRegime, nunca valores de este enum.
enum WorkRegimeKind {
  TURNO_OBLIGATORIO
  TURNO_FLEXIBLE
  SIN_TURNO
}

enum SegmentConceptStatus {
  SUGERIDO
  MANUAL
  SIN_CONCEPTO_COMPATIBLE
  CONCEPTO_NO_HABILITADO
}

model User {
  id           String       @id @default(uuid())
  name         String
  email        String       @unique
  passwordHash String
  role         RoleName
  status       RecordStatus @default(ACTIVO)
  companyId    String?
  sectorId     String?
  employeeId   String?      @unique
  createdAt    DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime     @updatedAt @db.Timestamptz(3)

  company                     Company?                       @relation(fields: [companyId], references: [id])
  sector                      Sector?                        @relation(fields: [sectorId], references: [id])
  employee                    Employee?                      @relation("EmployeeUserAccount", fields: [employeeId], references: [id])
  createdEmployees            Employee[]                     @relation("EmployeeCreatedBy")
  employeeAssignments         EmployeeAssignment[]
  laborMovements              LaborMovement[]
  fieldHistory                EmployeeFieldHistory[]
  blockHistory                EmployeeBlockHistory[]
  noveltiesCreated            Novelty[]                      @relation("NoveltyCreatedBy")
  timeEntriesCreated          TimeEntry[]                    @relation("TimeEntryCreatedBy")
  documentsUploaded           EmployeeDocument[]
  storageFilesUploaded        StorageFile[]                  @relation("StorageFileUploadedBy")
  storageFilesDeleted         StorageFile[]                  @relation("StorageFileDeletedBy")
  auditLogs                   AuditLog[]
  notifications               SystemNotification[]           @relation("NotificationRecipient")
  closuresSubmitted           MonthlyTimeClosure[]           @relation("ClosureSubmittedBy")
  closuresReviewed            MonthlyTimeClosure[]           @relation("ClosureReviewedBy")
  correctionsCreated          TimeCorrectionRequest[]        @relation("CorrectionCreatedBy")
  correctionsReviewed         TimeCorrectionRequest[]        @relation("CorrectionReviewedBy")
  inactivityIncidentsReviewed AttendanceInactivityIncident[] @relation("InactivityIncidentReviewedBy")
  noveltiesApproved           Novelty[]                      @relation("NoveltyApprovedBy")
  timeEntriesApproved         TimeEntry[]                    @relation("TimeEntryApprovedBy")
  workShiftsCreated           WorkShift[]                    @relation("WorkShiftCreatedBy")
  workShiftsReviewed          WorkShift[]                    @relation("WorkShiftReviewedBy")
  shiftTemplatesCreated       ShiftTemplate[]                @relation("ShiftTemplateCreatedBy")
  shiftTemplatesUpdated       ShiftTemplate[]                @relation("ShiftTemplateUpdatedBy")
  shiftAssignmentsAssigned    ShiftAssignment[]              @relation("ShiftAssignmentAssignedBy")
  shiftAssignmentsDisabled    ShiftAssignment[]              @relation("ShiftAssignmentDisabledBy")
  shiftAlertsResolved         ShiftAlert[]
  doubleHourRulesCreated      DoubleHourRule[]
  attendancePunchesReviewed   AttendancePunch[]
  auditParametersCreated      AuditParameter[]               @relation("AuditParameterCreatedBy")
  auditParametersUpdated      AuditParameter[]               @relation("AuditParameterUpdatedBy")
  workRegimesCreated          WorkRegime[]                   @relation("WorkRegimeCreatedBy")
  workRegimesUpdated          WorkRegime[]                   @relation("WorkRegimeUpdatedBy")
  workRegimesAssigned         EmployeeWorkRegime[]

  @@index([role])
  @@index([status])
}

model Company {
  id        String       @id @default(uuid())
  name      String       @unique
  code      String       @unique
  status    RecordStatus @default(ACTIVO)
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @db.Timestamptz(3)

  users           User[]
  businessUnits   BusinessUnit[]
  establishments  Establishment[]
  employees       EmployeeCompany[]
  costCenterLinks CostCenterCompany[]
}

model BusinessUnit {
  id        String       @id @default(uuid())
  name      String
  code      String
  status    RecordStatus @default(ACTIVO)
  companyId String
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @db.Timestamptz(3)

  company         Company                  @relation(fields: [companyId], references: [id])
  establishments  Establishment[]
  costCenterLinks CostCenterBusinessUnit[]

  @@unique([companyId, code])
  @@index([companyId])
}

model Establishment {
  id             String       @id @default(uuid())
  name           String
  code           String
  status         RecordStatus @default(ACTIVO)
  companyId      String
  businessUnitId String?
  province       String?
  department     String?
  city           String?
  street         String?
  streetNumber   String?
  postalCode     String?
  createdAt      DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime     @updatedAt @db.Timestamptz(3)

  company         Company                   @relation(fields: [companyId], references: [id])
  businessUnit    BusinessUnit?             @relation(fields: [businessUnitId], references: [id])
  areas           Area[]
  costCenterLinks CostCenterEstablishment[]

  @@unique([companyId, code])
  @@index([businessUnitId])
}

model Area {
  id              String       @id @default(uuid())
  name            String
  code            String       @unique
  status          RecordStatus @default(ACTIVO)
  establishmentId String?
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(3)

  establishment   Establishment?   @relation(fields: [establishmentId], references: [id])
  sectors         Sector[]
  costCenterLinks CostCenterArea[]

  @@index([establishmentId])
}

model Sector {
  id        String       @id @default(uuid())
  name      String
  code      String       @unique
  status    RecordStatus @default(ACTIVO)
  areaId    String?
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @db.Timestamptz(3)

  area            Area?              @relation(fields: [areaId], references: [id])
  users           User[]
  employees       Employee[]
  positions       Position[]
  costCenterLinks CostCenterSector[]

  @@index([areaId])
}

model CostCenter {
  id        String       @id @default(uuid())
  name      String
  code      String       @unique
  status    RecordStatus @default(ACTIVO)
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @db.Timestamptz(3)

  employees      Employee[]
  companies      CostCenterCompany[]
  businessUnits  CostCenterBusinessUnit[]
  establishments CostCenterEstablishment[]
  areas          CostCenterArea[]
  sectors        CostCenterSector[]
}

model CostCenterCompany {
  costCenterId String
  companyId    String

  costCenter CostCenter @relation(fields: [costCenterId], references: [id], onDelete: Cascade)
  company    Company    @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([costCenterId, companyId])
  @@index([companyId])
}

model CostCenterBusinessUnit {
  costCenterId   String
  businessUnitId String

  costCenter   CostCenter   @relation(fields: [costCenterId], references: [id], onDelete: Cascade)
  businessUnit BusinessUnit @relation(fields: [businessUnitId], references: [id], onDelete: Cascade)

  @@id([costCenterId, businessUnitId])
  @@index([businessUnitId])
}

model CostCenterEstablishment {
  costCenterId    String
  establishmentId String

  costCenter    CostCenter    @relation(fields: [costCenterId], references: [id], onDelete: Cascade)
  establishment Establishment @relation(fields: [establishmentId], references: [id], onDelete: Cascade)

  @@id([costCenterId, establishmentId])
  @@index([establishmentId])
}

model CostCenterArea {
  costCenterId String
  areaId       String

  costCenter CostCenter @relation(fields: [costCenterId], references: [id], onDelete: Cascade)
  area       Area       @relation(fields: [areaId], references: [id], onDelete: Cascade)

  @@id([costCenterId, areaId])
  @@index([areaId])
}

model CostCenterSector {
  costCenterId String
  sectorId     String

  costCenter CostCenter @relation(fields: [costCenterId], references: [id], onDelete: Cascade)
  sector     Sector     @relation(fields: [sectorId], references: [id], onDelete: Cascade)

  @@id([costCenterId, sectorId])
  @@index([sectorId])
}

model SalaryCategory {
  id        String       @id @default(uuid())
  name      String       @unique
  family    String?
  order     Int
  status    RecordStatus @default(ACTIVO)
  createdAt DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt DateTime     @updatedAt @db.Timestamptz(3)

  positions PositionSalaryCategory[]

  @@index([status])
}

model Position {
  id                    String       @id @default(uuid())
  code                  String       @unique
  name                  String
  status                RecordStatus @default(ACTIVO)
  mission               String?
  description           String?
  lastUpdatedAt         DateTime?    @db.Timestamptz(3)
  responsibilities      Json?
  internalRelations     Json?
  externalRelations     Json?
  competencies          Json?
  workConditions        Json?
  performanceIndicators Json?
  evaluationCriteria    Json?
  sectorId              String?
  createdAt             DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime     @updatedAt @db.Timestamptz(3)

  sector           Sector?                  @relation(fields: [sectorId], references: [id])
  employees        Employee[]
  salaryCategories PositionSalaryCategory[]

  @@index([sectorId])
  @@index([status])
}

model PositionSalaryCategory {
  positionId       String
  salaryCategoryId String

  position       Position       @relation(fields: [positionId], references: [id], onDelete: Cascade)
  salaryCategory SalaryCategory @relation(fields: [salaryCategoryId], references: [id], onDelete: Cascade)

  @@id([positionId, salaryCategoryId])
}

model Employee {
  id                String         @id @default(uuid())
  legajo            String         @unique
  legajoFinnegans   String?
  cuil              String         @unique
  dni               String         @unique
  firstName         String
  lastName          String
  birthDate         DateTime?      @db.Date
  gender            String?
  civilStatus       String?
  nationality       String?
  email             String?
  phone             String?
  mobile            String?
  emergencyContact  String?
  emergencyRelation String?
  emergencyPhone    String?
  status            EmployeeStatus @default(ACTIVO)
  positionId        String?
  sectorId          String?
  costCenterId      String?
  healthInsurance   String?
  agreement         String?
  receiptCategory   String?
  internalCategory  String?
  createdByUserId   String?
  createdAt         DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @db.Timestamptz(3)

  position              Position?                      @relation(fields: [positionId], references: [id])
  sector                Sector?                        @relation(fields: [sectorId], references: [id])
  costCenter            CostCenter?                    @relation(fields: [costCenterId], references: [id])
  createdBy             User?                          @relation("EmployeeCreatedBy", fields: [createdByUserId], references: [id])
  address               EmployeeAddress?
  companies             EmployeeCompany[]
  laborMovements        LaborMovement[]
  assignments           EmployeeAssignment[]
  hourConcepts          EmployeeHourConcept[]
  transport             EmployeeTransport?
  fieldHistory          EmployeeFieldHistory[]
  blockHistory          EmployeeBlockHistory[]
  novelties             Novelty[]
  timeEntries           TimeEntry[]
  workShifts            WorkShift[]
  attendancePunches     AttendancePunch[]
  clockPunchAttempts    ClockPunchAttempt[]
  timeSegments          TimeSegment[]
  documents             EmployeeDocument[]
  storageFiles          StorageFile[]
  monthlyClosures       MonthlyTimeClosure[]
  correctionRequests    TimeCorrectionRequest[]
  shiftAlerts           ShiftAlert[]
  inactivityIncidents   AttendanceInactivityIncident[]
  doubleHourAssignments DoubleHourRuleEmployee[]
  shiftAssignments      ShiftAssignment[]
  workRegimeAssignments EmployeeWorkRegime[]
  userAccount           User?                          @relation("EmployeeUserAccount")

  @@index([lastName, firstName])
  @@index([status])
  @@index([status, lastName, firstName])
  @@index([status, sectorId])
  @@index([status, costCenterId])
  @@index([sectorId])
  @@index([costCenterId])
}

model EmployeeCompany {
  employeeId String
  companyId  String
  isPrimary  Boolean @default(false)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  company  Company  @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([employeeId, companyId])
  @@index([companyId])
  @@index([companyId, employeeId])
}

model EmployeeAddress {
  id           String   @id @default(uuid())
  employeeId   String   @unique
  province     String?
  department   String?
  city         String?
  street       String?
  streetNumber String?
  postalCode   String?
  latitude     Decimal? @db.Decimal(10, 7)
  longitude    Decimal? @db.Decimal(10, 7)
  mapLabel     String?
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
}

model EmployeeTransport {
  id                   String   @id @default(uuid())
  employeeId           String   @unique
  usesCompanyTransport Boolean  @default(false)
  locality             String?
  pickupAddress        String?
  pickupReference      String?
  busLine              String?
  schedule             String?
  observation          String?
  createdAt            DateTime @default(now()) @db.Timestamptz(3)
  updatedAt            DateTime @updatedAt @db.Timestamptz(3)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)

  @@index([usesCompanyTransport])
}

model LaborMovement {
  id              String            @id @default(uuid())
  employeeId      String
  type            LaborMovementType
  effectiveFrom   DateTime          @db.Date
  reason          String
  observation     String?
  createdByUserId String?
  createdAt       DateTime          @default(now()) @db.Timestamptz(3)

  employee  Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  createdBy User?    @relation(fields: [createdByUserId], references: [id])

  @@index([employeeId, effectiveFrom])
  @@index([employeeId, type])
  @@index([type, effectiveFrom, employeeId])
}

model EmployeeAssignment {
  id            String    @id @default(uuid())
  employeeId    String
  userId        String?
  personName    String?
  type          String
  role          String?
  effectiveFrom DateTime? @db.Date
  effectiveTo   DateTime? @db.Date
  status        String?
  notes         String?
  createdAt     DateTime  @default(now()) @db.Timestamptz(3)

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  user     User?    @relation(fields: [userId], references: [id])

  @@index([employeeId, type])
  @@index([userId])
}

model HourConcept {
  id             String          @id @default(uuid())
  code           String          @unique
  name           String
  kind           HourConceptKind
  status         RecordStatus    @default(ACTIVO)
  countsAsWorked Boolean         @default(true)
  createdAt      DateTime        @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime        @updatedAt @db.Timestamptz(3)

  employees    EmployeeHourConcept[]
  timeEntries  TimeEntry[]
  novelties    Novelty[]
  timeSegments TimeSegment[]
  workShifts   WorkShift[]
  rules        HourConceptRule[]

  @@index([status])
}

model EmployeeHourConcept {
  employeeId    String
  hourConceptId String

  employee    Employee    @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  hourConcept HourConcept @relation(fields: [hourConceptId], references: [id], onDelete: Cascade)

  @@id([employeeId, hourConceptId])
}

// Regla de sugerencia (no de bloqueo): en qué rango horario un HourConcept
// aplica por defecto, para partir automáticamente una jornada real en
// segmentos (ej. Guardia 21:00-04:00). Si un tramo no matchea ninguna regla,
// el segmento queda con conceptStatus = SIN_CONCEPTO_COMPATIBLE, nunca bloquea
// la fichada. Los horarios reales del cliente son datos de instancia
// (seed/demo/testing), nunca valores fijos en el backend.
model HourConceptRule {
  id              String       @id @default(uuid())
  hourConceptId   String
  startTime       String
  endTime         String
  crossesMidnight Boolean      @default(false)
  priority        Int          @default(0)
  status          RecordStatus @default(ACTIVO)
  createdAt       DateTime     @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime     @updatedAt @db.Timestamptz(3)

  hourConcept  HourConcept   @relation(fields: [hourConceptId], references: [id], onDelete: Cascade)
  timeSegments TimeSegment[]

  @@index([hourConceptId, status])
}

model EmployeeFieldHistory {
  id              String   @id @default(uuid())
  employeeId      String
  section         String
  field           String
  fieldLabel      String
  oldValue        String?
  newValue        String
  effectiveFrom   DateTime @db.Date
  reason          String
  createdByUserId String?
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  employee  Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  createdBy User?    @relation(fields: [createdByUserId], references: [id])

  @@index([employeeId, section, field])
  @@index([effectiveFrom])
}

model EmployeeBlockHistory {
  id              String   @id @default(uuid())
  employeeId      String
  section         String
  block           String
  blockLabel      String
  oldValue        String?
  newValue        String
  effectiveFrom   DateTime @db.Date
  reason          String
  createdByUserId String?
  createdAt       DateTime @default(now()) @db.Timestamptz(3)

  employee  Employee @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  createdBy User?    @relation(fields: [createdByUserId], references: [id])

  @@index([employeeId, section, block])
  @@index([effectiveFrom])
}

model NoveltyType {
  id                    String            @id @default(uuid())
  code                  String            @unique
  name                  String
  uiColor               String
  kind                  NoveltyTypeKind
  origin                NoveltyTypeOrigin
  status                RecordStatus      @default(ACTIVO)
  description           String?
  exportsToFinnegans    Boolean           @default(false)
  requiresApproval      Boolean           @default(true)
  requiresDocumentation Boolean           @default(false)
  allowsHours           Boolean           @default(false)
  allowsDateTo          Boolean           @default(true)
  hasValidity           Boolean           @default(true)
  blocksTimeEntry       Boolean           @default(false)
  setsWorkedHoursToZero Boolean           @default(false)
  timeImpact            NoveltyTimeImpact @default(NO_AFECTA_HORAS)
  allowedLoadRoles      Json              @default("[]")
  approvalRoles         Json              @default("[]")
  createdAt             DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt             DateTime          @updatedAt @db.Timestamptz(3)

  finnegansLinks FinnegansNoveltyLink[]
  novelties      Novelty[]

  @@index([status])
}

model FinnegansNoveltyLink {
  id            String       @id @default(uuid())
  noveltyTypeId String
  code          String
  name          String
  exportConcept String
  priority      Int          @default(1)
  status        RecordStatus @default(ACTIVO)
  hasValidity   Boolean      @default(false)
  notes         String?

  noveltyType NoveltyType @relation(fields: [noveltyTypeId], references: [id], onDelete: Cascade)

  @@unique([noveltyTypeId, code])
  @@index([noveltyTypeId])
}

model Novelty {
  id                  String         @id @default(uuid())
  employeeId          String
  noveltyTypeId       String
  status              ApprovalStatus @default(PENDIENTE)
  fromDate            DateTime       @db.Date
  toDate              DateTime?      @db.Date
  quantityHours       Decimal?       @db.Decimal(8, 2)
  quantityDays        Decimal?       @db.Decimal(8, 2)
  observation         String?
  targetHourConceptId String?
  createdByUserId     String?
  approvedByUserId    String?
  approvedAt          DateTime?      @db.Timestamptz(3)
  rejectedAt          DateTime?      @db.Timestamptz(3)
  createdAt           DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt           DateTime       @updatedAt @db.Timestamptz(3)

  employee          Employee           @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  noveltyType       NoveltyType        @relation(fields: [noveltyTypeId], references: [id])
  targetHourConcept HourConcept?       @relation(fields: [targetHourConceptId], references: [id])
  createdBy         User?              @relation("NoveltyCreatedBy", fields: [createdByUserId], references: [id])
  approvedBy        User?              @relation("NoveltyApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  documents         EmployeeDocument[]

  @@index([employeeId, fromDate])
  @@index([employeeId, status, fromDate])
  @@index([status, fromDate])
  @@index([fromDate, toDate])
  @@index([noveltyTypeId])
  @@index([status])
}

model TimeEntry {
  id                String           @id @default(uuid())
  employeeId        String
  hourConceptId     String
  workShiftId       String?
  timeSegmentId     String?
  date              DateTime         @db.Date
  period            String
  day               Int
  hours             Decimal          @db.Decimal(8, 2)
  totalMinutes      Int
  actualMinutes     Int?
  appliedMultiplier Decimal          @default(1) @db.Decimal(4, 2)
  segmentStartAt    DateTime?        @db.Timestamptz(3)
  segmentEndAt      DateTime?        @db.Timestamptz(3)
  source            WorkShiftSource?
  status            ApprovalStatus   @default(BORRADOR)
  observation       String?
  createdByUserId   String?
  approvedByUserId  String?
  approvedAt        DateTime?        @db.Timestamptz(3)
  rejectedAt        DateTime?        @db.Timestamptz(3)
  createdAt         DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime         @updatedAt @db.Timestamptz(3)

  employee           Employee                @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  hourConcept        HourConcept             @relation(fields: [hourConceptId], references: [id])
  workShift          WorkShift?              @relation(fields: [workShiftId], references: [id], onDelete: SetNull)
  timeSegment        TimeSegment?            @relation(fields: [timeSegmentId], references: [id], onDelete: SetNull)
  createdBy          User?                   @relation("TimeEntryCreatedBy", fields: [createdByUserId], references: [id])
  approvedBy         User?                   @relation("TimeEntryApprovedBy", fields: [approvedByUserId], references: [id], onDelete: SetNull)
  correctionRequests TimeCorrectionRequest[]

  @@index([employeeId, period])
  @@index([employeeId, hourConceptId, date])
  @@index([workShiftId])
  @@index([timeSegmentId])
  @@index([period, employeeId])
  @@index([period, status])
  @@index([period, status, employeeId])
  @@index([period, status, date, createdAt])
  @@index([date])
  @@index([status])
  @@index([status, period])
}

model WorkShift {
  id                String                 @id @default(uuid())
  employeeId        String
  hourConceptId     String?
  hourConceptName   String?
  startPunchId      String?
  endPunchId        String?
  source            WorkShiftSource        @default(ADMIN)
  status            WorkShiftStatus        @default(PROCESADO)
  startAt           DateTime               @db.Timestamptz(3)
  endAt             DateTime?              @db.Timestamptz(3)
  totalMinutes      Int?
  crossesMidnight   Boolean                @default(false)
  maxAllowedMinutes Int                    @default(1200)
  observation       String?
  reviewStatus      AttendanceReviewStatus @default(PENDIENTE)
  reviewedAt        DateTime?              @db.Timestamptz(3)
  reviewedByUserId  String?
  reviewNote        String?
  shiftTemplateId   String?
  createdByUserId   String?
  createdAt         DateTime               @default(now()) @db.Timestamptz(3)
  closedAt          DateTime?              @db.Timestamptz(3)
  updatedAt         DateTime               @updatedAt @db.Timestamptz(3)

  employee      Employee         @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  hourConcept   HourConcept?     @relation(fields: [hourConceptId], references: [id], onDelete: SetNull)
  startPunch    AttendancePunch? @relation("WorkShiftStartPunch", fields: [startPunchId], references: [id], onDelete: SetNull)
  endPunch      AttendancePunch? @relation("WorkShiftEndPunch", fields: [endPunchId], references: [id], onDelete: SetNull)
  timeEntries   TimeEntry[]
  timeSegments  TimeSegment[]
  shiftTemplate ShiftTemplate?   @relation(fields: [shiftTemplateId], references: [id], onDelete: SetNull)
  shiftAlerts   ShiftAlert[]
