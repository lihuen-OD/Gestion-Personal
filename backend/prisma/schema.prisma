  priority        String             @default("NORMAL")
  title           String
  message         String
  entityType      String?
  entityId        String?
  link            String?
  status          NotificationStatus @default(NO_LEIDA)
  readAt          DateTime?          @db.Timestamptz(3)
  createdAt       DateTime           @default(now()) @db.Timestamptz(3)
  recipient       User               @relation("NotificationRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)

  @@index([recipientUserId, status, createdAt])
}

model ShiftTemplate {
  id                            String            @id @default(uuid())
  code                          String            @unique
  name                          String
  description                   String?
  categoryName                  String?
  startTime                     String
  endTime                       String
  crossesMidnight               Boolean           @default(false)
  expectedMinutes               Int?
  entryToleranceBeforeMinutes   Int               @default(10)
  entryToleranceAfterMinutes    Int               @default(10)
  exitToleranceBeforeMinutes    Int               @default(20)
  exitToleranceAfterMinutes     Int               @default(20)
  minimumMinutesForCompliance   Int?
  maximumInformativeMinutes     Int?
  missingOutAlertAfterMinutes   Int?
  absoluteOpenShiftLimitMinutes Int               @default(1200)
  // Umbrales informativos de jornada extendida (severidad graduada). No
  // reemplazan absoluteOpenShiftLimitMinutes (que sigue gobernando el
  // rollover actual sin cambios en esta etapa) — se usan para graduar la
  // alerta JORNADA_EXTENDIDA entre ADVERTENCIA y CRITICA.
  warningThresholdMinutes       Int               @default(720)
  reviewThresholdMinutes        Int               @default(960)
  criticalThresholdMinutes      Int?
  status                        RecordStatus      @default(ACTIVO)
  createdByUserId               String?
  updatedByUserId               String?
  createdAt                     DateTime          @default(now()) @db.Timestamptz(3)
  updatedAt                     DateTime          @updatedAt @db.Timestamptz(3)
  workShifts                    WorkShift[]
  assignments                   ShiftAssignment[]
  createdBy                     User?             @relation("ShiftTemplateCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy                     User?             @relation("ShiftTemplateUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([categoryName])
}

model ShiftAssignment {
  id               String                @id @default(uuid())
  employeeId       String
  shiftTemplateId  String
  status           ShiftAssignmentStatus @default(HABILITADO)
  // Vigencia + días de la semana en los que aplica esta asignación (rotativos
  // versión simple V1: RRHH crea 2 asignaciones con vigencias que se alternan
  // manualmente; sin automatización de alternancia todavía). weekdays vacío
  // significa todos los días.
  effectiveFrom    DateTime              @default(now()) @db.Date
  effectiveTo      DateTime?             @db.Date
  weekdays         Int[]                 @default([])
  assignedAt       DateTime              @default(now()) @db.Timestamptz(3)
  assignedByUserId String?
  disabledAt       DateTime?             @db.Timestamptz(3)
  disabledByUserId String?
  observation      String?
  createdAt        DateTime              @default(now()) @db.Timestamptz(3)
  updatedAt        DateTime              @updatedAt @db.Timestamptz(3)

  employee      Employee      @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  shiftTemplate ShiftTemplate @relation(fields: [shiftTemplateId], references: [id], onDelete: Cascade)
  assignedBy    User?         @relation("ShiftAssignmentAssignedBy", fields: [assignedByUserId], references: [id], onDelete: SetNull)
  disabledBy    User?         @relation("ShiftAssignmentDisabledBy", fields: [disabledByUserId], references: [id], onDelete: SetNull)

  @@unique([employeeId, shiftTemplateId])
  @@index([employeeId, status])
  @@index([shiftTemplateId, status])
}

// Régimen de trabajo: comportamiento genérico (3 kinds fijos). Los nombres
// concretos (Cosecha, Riego, Campaña, Jornada libre controlada, etc.) son
// instancias configurables por RRHH, nunca valores de enum ni lógica
// hardcodeada. alertOnOutOfShift decide si "fuera de turno"/"sin turno" debe
// alertar para este régimen (ver EmployeeWorkRegime para la asignación).
model WorkRegime {
  id                String         @id @default(uuid())
  code              String         @unique
  name              String
  kind              WorkRegimeKind
  alertOnOutOfShift Boolean        @default(true)
  description       String?
  status            RecordStatus   @default(ACTIVO)
  createdByUserId   String?
  updatedByUserId   String?
  createdAt         DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt         DateTime       @updatedAt @db.Timestamptz(3)

  createdBy           User?                @relation("WorkRegimeCreatedBy", fields: [createdByUserId], references: [id], onDelete: SetNull)
  updatedBy           User?                @relation("WorkRegimeUpdatedBy", fields: [updatedByUserId], references: [id], onDelete: SetNull)
  employeeAssignments EmployeeWorkRegime[]

  @@index([status])
  @@index([kind])
}

// Régimen vigente de un empleado, resuelto por fecha (mismo patrón que
// Employee.status se deriva de LaborMovement) — no un booleano simple, para
// que un empleado pueda pasar de un régimen a otro estacionalmente sin perder
// historial. Restrict en ambas FK: no perder trazabilidad si se intenta
// inactivar/borrar un Employee o un WorkRegime con asignaciones existentes.
model EmployeeWorkRegime {
  id               String    @id @default(uuid())
  employeeId       String
  workRegimeId     String
  effectiveFrom    DateTime  @db.Date
  effectiveTo      DateTime? @db.Date
  assignedByUserId String?
  createdAt        DateTime  @default(now()) @db.Timestamptz(3)

  employee   Employee   @relation(fields: [employeeId], references: [id], onDelete: Restrict)
  workRegime WorkRegime @relation(fields: [workRegimeId], references: [id], onDelete: Restrict)
  assignedBy User?      @relation(fields: [assignedByUserId], references: [id], onDelete: SetNull)

  @@index([employeeId, effectiveFrom])
}

model ShiftAlert {
  id                String             @id @default(uuid())
  employeeId        String
  workShiftId       String
  type              ShiftAlertType
  status            ShiftAlertStatus   @default(PENDIENTE)
  severity          ShiftAlertSeverity @default(INFO)
