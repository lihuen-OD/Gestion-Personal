{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": { "npm_config_yes": "false" },
  "permissions": {
    "allow": [
      "Bash(npx tsc *)",
      "Bash(npm run typecheck *)", "Bash(npm run -s typecheck *)",
      "Bash(npm run typecheck:e2e *)", "Bash(npm run -s typecheck:e2e *)"
    ],
    "ask": [
      "Bash(npm run *staging*)", "Bash(npm run *prisma*)",
      "Bash(*--apply*)", "Bash(*--mode=repair*)", "Bash(*neon-admin*)", "Bash(*org-wipe*)"
    ]
  }
}
