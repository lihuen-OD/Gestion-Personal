VITE_API_URL=http://localhost:4002/api
APP_ENV=staging
VITE_APP_ENV=staging
VITE_DEMO_MODE=false

# Debe coincidir con CLOCK_DEVICE_TOKEN en backend/.env — el fichador
# (TimeClockPage, sin sesion de usuario) lo envia en cada llamada a /clock/*.
# Mitigacion minima y TEMPORAL contra abuso anonimo de la API, no un control
# biometrico ni un secreto realmente inaccesible (queda embebido en el bundle
# publico del kiosco) — no es seguridad final de produccion. Ver
# docs/SECURITY_STANDARDS.md -> "Public clock endpoints (fichador)".
# Si se deja vacio, el fichador sigue funcionando sin este header en
# development/test/demo; en un backend con NODE_ENV=production sin
# CLOCK_DEVICE_TOKEN configurado, /clock/* queda rechazado (falla cerrado).
VITE_CLOCK_DEVICE_TOKEN=
