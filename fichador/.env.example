# Fichador standalone (F1). Copiar a .env (gitignoreado) y completar.

# URL del backend compartido, terminando en /api. Local: el backend de
# `cd backend && npm run dev` (puerto 4002). En un deploy futuro, la URL
# pública del backend; su CORS_ORIGIN tiene que incluir el origin del
# fichador (local: http://localhost:5175).
VITE_API_URL=http://localhost:4002/api

# Token compartido del kiosco: el mismo valor que CLOCK_DEVICE_TOKEN del
# backend (y que VITE_CLOCK_DEVICE_TOKEN de frontend/.env mientras exista
# /fichador en el admin). Esta credencial sigue siendo temporal y será
# retirada en F4–F6 (ClockDevice). No es un secreto: como toda variable
# VITE_*, Vite la inlinea en el bundle. Nunca versionar el valor real.
VITE_CLOCK_DEVICE_TOKEN=
